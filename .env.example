# Relative paths work both for local runs and inside the container (WORKDIR=/code)
DATA_FOLDER=./data
DATABASE_PATH=./data/competitions.sqlite3
WEB_HOST=0.0.0.0
WEB_PORT=8080
# Must be a random value: weak defaults block startup
AUTH_SECRET_KEY=replace-with-random-string
# Accounts are created at FIRST start only; afterwards passwords are managed
# in the admin UI. Weak/placeholder passwords (change-me*) block the first
# start. Leave both AUTH_VIEWER_* empty to skip creating the viewer account.
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=change-me
AUTH_EDITOR_USERNAME=editor
AUTH_EDITOR_PASSWORD=change-me-editor
AUTH_VIEWER_USERNAME=viewer
AUTH_VIEWER_PASSWORD=change-me-viewer
