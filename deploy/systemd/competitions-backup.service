[Unit]
Description=Backup competitions SQLite database
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
UMask=0077
WorkingDirectory=/root/chatgpt/competitions
ExecStart=/usr/bin/python3 /root/chatgpt/competitions/scripts/backup_sqlite.py --db-path /root/chatgpt/competitions/data/competitions.sqlite3 --output-dir /root/chatgpt/competitions/data/backups/sqlite --files-dir /root/chatgpt/competitions/data/files --keep 14 --source daily --state-dir /root/chatgpt/competitions/data/ops
